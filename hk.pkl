amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

local linters = new Mapping<String, Step> {
  ["format"] {
    glob = List("*.rs")
    exclusive = true
    check = "mise run format"
    fix = "mise run format:fix"
  }
  ["lint"] {
    glob = List("*.rs")
    exclusive = true
    check = "mise run lint"
    fix = "mise run lint:fix"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
